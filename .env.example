# SEMANTIQ Environment Configuration Template
# Copy to .env and fill in your values. NEVER commit .env to version control.
# All fields are required for production. See README for details.

# ── Application Environment ──────────────────────────────────────────────────
APP_ENV=production
PORT=8000

# ── PostgreSQL Database (Required — SQLite is not supported) ─────────────────
# Render internal URL format: postgresql://user:pass@host:5432/dbname
DATABASE_URL=
POSTGRES_SCHEMA=semantiq

# ── Authentication ───────────────────────────────────────────────────────────
# High-entropy secret for HMAC-SHA256 token signing. Minimum 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# ── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No wildcards.
CORS_ORIGINS=

# ── Benchmark Account Seed Passwords ─────────────────────────────────────────
# Used ONCE on a fresh database to create the four benchmark accounts.
# Passwords are hashed with PBKDF2-HMAC-SHA256 before storage — never plaintext.
# A Render redeployment will NOT overwrite existing passwords.
SEED_ADMIN_PASSWORD=
SEED_OPERATIONS_PASSWORD=
SEED_PROJECT_MANAGER_PASSWORD=
SEED_VIEWER_PASSWORD=

# ── One-time benchmark password migration ────────────────────────────────────
# Set to true ONCE to reset the four benchmark account passwords to the current
# SEED_*_PASSWORD values on an existing database. The app records a completion
# marker in system_metadata after the first run and will never repeat the reset,
# even if this variable remains enabled in subsequent deployments.
# DEFAULT MUST BE false. Never set to true permanently.
RESET_BENCHMARK_PASSWORDS=false
