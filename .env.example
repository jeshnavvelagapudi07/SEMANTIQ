# SEMANTIQ Configuration & Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# Google Gemini API Key
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Environment (development / test / production)
# In production, valid JWT authentication is strictly required on all endpoints.
APP_ENV=development
ENVIRONMENT=development

# Server Port
PORT=8000

# Database Configuration
# Local development: sqlite:///./semantiq.db
# Production: postgresql://user:password@hostname:5432/semantiq_db
DATABASE_URL=sqlite:///./semantiq.db
DATABASE_PATH=./semantiq.db

# Authentication Secret Key (Used for HMAC/JWT token signing)
AUTH_SECRET_KEY=change_this_to_a_secure_random_string_in_production

# CORS Allowed Origins (Comma-separated list of allowed origins)
# In production, set to your exact frontend domain without wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
